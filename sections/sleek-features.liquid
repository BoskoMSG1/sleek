{{ 'section-sleek-features.css' | asset_url | stylesheet_tag }}

<div class="sleek-features-section sleek-section">
  <div class="sleek-container">
    
    <!-- Section Header -->
    <div class="sleek-features-header">
      <div class="sleek-features-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2"/>
          <path d="M2 17L12 22L22 17M2 12L12 17L22 12" stroke="currentColor" stroke-width="2"/>
        </svg>
        <span>{{ section.settings.badge_text }}</span>
      </div>
      <h2 class="sleek-features-title">{{ section.settings.title }}</h2>
      <p class="sleek-features-description">{{ section.settings.description }}</p>
    </div>

    <!-- Features Grid -->
    <div class="sleek-features-grid">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="sleek-feature-card sleek-glass-card" {{ block.shopify_attributes }}>
            <div class="sleek-feature-icon-wrapper">
              <div class="sleek-feature-icon" style="background: {{ block.settings.icon_color }};">
                {{ block.settings.icon_svg }}
              </div>
              {% if block.settings.show_badge %}
                <span class="sleek-feature-badge">{{ block.settings.badge_text }}</span>
              {% endif %}
            </div>
            
            <h3 class="sleek-feature-title">{{ block.settings.title }}</h3>
            <p class="sleek-feature-description">{{ block.settings.description }}</p>
            
            {% if block.settings.features_list != blank %}
              <ul class="sleek-feature-list">
                {% assign features = block.settings.features_list | split: '|' %}
                {% for feature in features %}
                  <li class="sleek-feature-list-item">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                      <path d="M16.667 5L7.5 14.167 3.333 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ feature }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_link }}" class="sleek-feature-link">
                {{ block.settings.button_text }}
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                  <path d="M4.167 10h11.666M10 4.167L15.833 10 10 15.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- CTA Section -->
    {% if section.settings.show_cta %}
      <div class="sleek-features-cta sleek-glass-card">
        <div class="sleek-cta-content">
          <h3 class="sleek-cta-title">{{ section.settings.cta_title }}</h3>
          <p class="sleek-cta-text">{{ section.settings.cta_text }}</p>
        </div>
        <div class="sleek-cta-buttons">
          {% if section.settings.cta_primary_text != blank %}
            <a href="{{ section.settings.cta_primary_link }}" class="sleek-btn sleek-btn-primary">
              {{ section.settings.cta_primary_text }}
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4.167 10h11.666M10 4.167L15.833 10 10 15.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.cta_secondary_text != blank %}
            <a href="{{ section.settings.cta_secondary_link }}" class="sleek-btn sleek-btn-glass">
              {{ section.settings.cta_secondary_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>
</div>

<style>
.sleek-features-section {
  padding: 100px 0;
  position: relative;
}

.sleek-features-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 80px;
}

.sleek-features-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--glass-bg-light);
  backdrop-filter: var(--blur-light);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-full);
  font-size: 14px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-primary);
  margin-bottom: 24px;
}

.sleek-features-badge svg {
  color: var(--sleek-primary);
}

.sleek-features-title {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: var(--font-weight-heavy);
  line-height: 1.2;
  margin: 0 0 20px;
  letter-spacing: -0.02em;
}

.sleek-features-description {
  font-size: 18px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  margin: 0;
}

.sleek-features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 750px) {
  .sleek-features-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
}

@media (min-width: 990px) {
  .sleek-features-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.sleek-feature-card {
  padding: 32px;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}

.sleek-feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--sleek-primary), var(--sleek-secondary));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition-base);
}

.sleek-feature-card:hover::before {
  transform: scaleX(1);
}

.sleek-feature-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-2xl);
}

.sleek-feature-icon-wrapper {
  position: relative;
  margin-bottom: 24px;
  display: inline-block;
}

.sleek-feature-icon {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: var(--shadow-lg);
  transition: all var(--transition-base);
}

.sleek-feature-card:hover .sleek-feature-icon {
  transform: scale(1.05) rotate(-5deg);
  box-shadow: var(--shadow-xl);
}

.sleek-feature-icon svg {
  width: 32px;
  height: 32px;
}

.sleek-feature-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  padding: 4px 8px;
  background: var(--sleek-danger);
  color: white;
  font-size: 11px;
  font-weight: var(--font-weight-bold);
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: var(--shadow-md);
}

.sleek-feature-title {
  font-size: 22px;
  font-weight: var(--font-weight-semibold);
  margin: 0 0 12px;
  color: var(--sleek-dark);
}

.sleek-feature-description {
  font-size: 15px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  margin: 0 0 20px;
  flex-grow: 1;
}

.sleek-feature-list {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sleek-feature-list-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  color: var(--sleek-gray-700);
}

.sleek-feature-list-item svg {
  color: var(--sleek-success);
  flex-shrink: 0;
  margin-top: 2px;
}

.sleek-feature-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15px;
  font-weight: var(--font-weight-semibold);
  color: var(--sleek-primary);
  text-decoration: none;
  transition: all var(--transition-base);
  margin-top: auto;
}

.sleek-feature-link:hover {
  gap: 10px;
  color: var(--sleek-secondary);
}

.sleek-feature-link svg {
  transition: transform var(--transition-base);
}

.sleek-feature-link:hover svg {
  transform: translateX(4px);
}

.sleek-features-cta {
  margin-top: 80px;
  padding: 48px;
  display: flex;
  flex-direction: column;
  gap: 32px;
  align-items: center;
  text-align: center;
}

@media (min-width: 990px) {
  .sleek-features-cta {
    flex-direction: row;
    text-align: left;
    justify-content: space-between;
  }
}

.sleek-cta-content {
  flex: 1;
}

.sleek-cta-title {
  font-size: 28px;
  font-weight: var(--font-weight-bold);
  margin: 0 0 12px;
}

.sleek-cta-text {
  font-size: 16px;
  color: var(--sleek-gray-600);
  margin: 0;
  max-width: 500px;
}

.sleek-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.sleek-feature-card {
  animation: fadeInUp 0.6s ease-out backwards;
}

.sleek-feature-card:nth-child(1) { animation-delay: 0.1s; }
.sleek-feature-card:nth-child(2) { animation-delay: 0.2s; }
.sleek-feature-card:nth-child(3) { animation-delay: 0.3s; }
.sleek-feature-card:nth-child(4) { animation-delay: 0.4s; }
.sleek-feature-card:nth-child(5) { animation-delay: 0.5s; }
.sleek-feature-card:nth-child(6) { animation-delay: 0.6s; }
</style>

