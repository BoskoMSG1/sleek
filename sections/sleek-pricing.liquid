{{ 'section-sleek-pricing.css' | asset_url | stylesheet_tag }}

<div class="sleek-pricing-section sleek-section">
  <div class="sleek-container">
    
    <!-- Section Header -->
    <div class="sleek-pricing-header">
      <div class="sleek-pricing-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>{{ section.settings.badge_text }}</span>
      </div>
      <h2 class="sleek-pricing-title">{{ section.settings.title }}</h2>
      <p class="sleek-pricing-description">{{ section.settings.description }}</p>
    </div>

    <!-- Pricing Cards -->
    <div class="sleek-pricing-grid">
      {% for block in section.blocks %}
        {% if block.type == 'pricing_plan' %}
          <div class="sleek-pricing-card sleek-glass-card {% if block.settings.is_popular %}sleek-pricing-popular{% endif %}" {{ block.shopify_attributes }}>
            
            {% if block.settings.is_popular %}
              <div class="sleek-popular-badge">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
                </svg>
                Most Popular
              </div>
            {% endif %}

            <div class="sleek-pricing-plan-header">
              <div class="sleek-plan-icon" style="background: {{ block.settings.icon_color }};">
                {{ block.settings.icon_svg }}
              </div>
              <h3 class="sleek-plan-name">{{ block.settings.plan_name }}</h3>
              <p class="sleek-plan-description">{{ block.settings.plan_description }}</p>
            </div>

            <div class="sleek-pricing-breakdown">
              <div class="sleek-price-item">
                <span class="sleek-price-label">Setup Fee</span>
                <div class="sleek-price-amount-wrapper">
                  <span class="sleek-price-currency">€</span>
                  <span class="sleek-price-amount">{{ block.settings.setup_price }}</span>
                  <span class="sleek-price-once">one-time</span>
                </div>
              </div>
              
              <div class="sleek-price-divider">+</div>
              
              <div class="sleek-price-item">
                <span class="sleek-price-label">Monthly</span>
                <div class="sleek-price-amount-wrapper">
                  <span class="sleek-price-currency">€</span>
                  <span class="sleek-price-amount">{{ block.settings.monthly_price }}</span>
                  <span class="sleek-price-period">/month</span>
                </div>
              </div>
            </div>

            {% if block.settings.total_first_year != blank %}
              <p class="sleek-price-total">Total first year: <strong>€{{ block.settings.total_first_year }}</strong></p>
            {% endif %}

            {% if block.settings.features_list != blank %}
              <ul class="sleek-pricing-features">
                {% assign features = block.settings.features_list | split: '|' %}
                {% for feature in features %}
                  <li class="sleek-pricing-feature">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                      <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.1"/>
                      <path d="M6 10l2.5 2.5L14 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ feature }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            <a href="{{ block.settings.button_link }}" class="sleek-pricing-button {% if block.settings.is_popular %}sleek-btn-primary{% else %}sleek-btn-glass{% endif %}">
              {{ block.settings.button_text }}
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4.167 10h11.666M10 4.167L15.833 10 10 15.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            {% if block.settings.note != blank %}
              <p class="sleek-pricing-note">{{ block.settings.note }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- What's Included Section -->
    {% if section.settings.show_whats_included %}
      <div class="sleek-whats-included">
        <h3 class="sleek-included-title">{{ section.settings.included_title }}</h3>
        <div class="sleek-included-grid">
          <div class="sleek-included-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>SSL Security</span>
          </div>
          <div class="sleek-included-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke="currentColor" stroke-width="2"/>
              <polyline points="7.5 4.21 12 6.81 16.5 4.21" stroke="currentColor" stroke-width="2"/>
              <polyline points="7.5 19.79 7.5 14.6 3 12" stroke="currentColor" stroke-width="2"/>
              <polyline points="21 12 16.5 14.6 16.5 19.79" stroke="currentColor" stroke-width="2"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="currentColor" stroke-width="2"/>
              <line x1="12" y1="22.08" x2="12" y2="12" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>Cloud Hosting</span>
          </div>
          <div class="sleek-included-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
              <polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>24/7 Monitoring</span>
          </div>
          <div class="sleek-included-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Regular Updates</span>
          </div>
          <div class="sleek-included-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>Priority Support</span>
          </div>
          <div class="sleek-included-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="2"/>
              <polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>GDPR Compliant</span>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Trust Badges -->
    {% if section.settings.show_trust_badges %}
      <div class="sleek-trust-section">
        <p class="sleek-trust-text">{{ section.settings.trust_text }}</p>
        <div class="sleek-trust-badges">
          <div class="sleek-trust-badge">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/>
              <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div>
              <div class="sleek-trust-title">Secure Payments</div>
              <div class="sleek-trust-subtitle">256-bit SSL encryption</div>
            </div>
          </div>
          <div class="sleek-trust-badge">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div>
              <div class="sleek-trust-title">Money-Back Guarantee</div>
              <div class="sleek-trust-subtitle">30-day refund policy</div>
            </div>
          </div>
          <div class="sleek-trust-badge">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
              <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div>
              <div class="sleek-trust-title">Quick Setup</div>
              <div class="sleek-trust-subtitle">Live in 7-14 days</div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</div>

<style>
.sleek-pricing-section {
  padding: 100px 0;
  position: relative;
}

.sleek-pricing-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 60px;
}

.sleek-pricing-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.1), rgba(48, 209, 88, 0.1));
  border: 1px solid rgba(52, 199, 89, 0.2);
  border-radius: var(--radius-full);
  font-size: 14px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-success);
  margin-bottom: 24px;
}

.sleek-pricing-badge svg {
  color: var(--sleek-success);
}

.sleek-pricing-title {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: var(--font-weight-heavy);
  line-height: 1.2;
  margin: 0 0 20px;
  letter-spacing: -0.02em;
}

.sleek-pricing-description {
  font-size: 18px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  margin: 0;
}

.sleek-pricing-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  margin-bottom: 80px;
}

@media (min-width: 750px) {
  .sleek-pricing-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.sleek-pricing-card {
  padding: 40px 32px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all var(--transition-base);
}

.sleek-pricing-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-2xl);
}

.sleek-pricing-popular {
  border: 2px solid var(--sleek-primary);
  transform: scale(1.05);
}

.sleek-pricing-popular:hover {
  transform: scale(1.05) translateY(-8px);
}

.sleek-popular-badge {
  position: absolute;
  top: -16px;
  left: 50%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  color: white;
  font-size: 13px;
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-lg);
  white-space: nowrap;
}

.sleek-popular-badge svg {
  width: 14px;
  height: 14px;
}

.sleek-pricing-plan-header {
  text-align: center;
  margin-bottom: 32px;
}

.sleek-plan-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: var(--shadow-lg);
}

.sleek-plan-icon svg {
  width: 32px;
  height: 32px;
}

.sleek-plan-name {
  font-size: 24px;
  font-weight: var(--font-weight-bold);
  margin: 0 0 8px;
}

.sleek-plan-description {
  font-size: 14px;
  color: var(--sleek-gray-600);
  margin: 0;
}

.sleek-pricing-breakdown {
  text-align: center;
  padding: 24px 0;
  margin-bottom: 16px;
  border-top: 1px solid var(--sleek-gray-200);
  border-bottom: 1px solid var(--sleek-gray-200);
}

.sleek-price-item {
  margin-bottom: 16px;
}

.sleek-price-item:last-child {
  margin-bottom: 0;
}

.sleek-price-label {
  display: block;
  font-size: 13px;
  color: var(--sleek-gray-600);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.sleek-price-amount-wrapper {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4px;
}

.sleek-price-currency {
  font-size: 20px;
  font-weight: var(--font-weight-semibold);
  color: var(--sleek-gray-700);
}

.sleek-price-amount {
  font-size: 42px;
  font-weight: var(--font-weight-heavy);
  line-height: 1;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.sleek-price-once,
.sleek-price-period {
  font-size: 14px;
  color: var(--sleek-gray-600);
}

.sleek-price-divider {
  font-size: 24px;
  font-weight: var(--font-weight-bold);
  color: var(--sleek-gray-400);
  margin: 12px 0;
}

.sleek-price-total {
  text-align: center;
  font-size: 14px;
  color: var(--sleek-gray-600);
  margin: 0 0 24px;
}

.sleek-price-total strong {
  color: var(--sleek-dark);
  font-weight: var(--font-weight-bold);
}

.sleek-pricing-features {
  list-style: none;
  padding: 0;
  margin: 0 0 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex-grow: 1;
}

.sleek-pricing-feature {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 15px;
  color: var(--sleek-gray-700);
}

.sleek-pricing-feature svg {
  color: var(--sleek-success);
  flex-shrink: 0;
  margin-top: 2px;
}

.sleek-pricing-button {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  font-family: var(--font-ios);
  font-size: 16px;
  font-weight: var(--font-weight-semibold);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
  margin-bottom: 12px;
}

.sleek-pricing-note {
  text-align: center;
  font-size: 12px;
  color: var(--sleek-gray-500);
  margin: 0;
}

.sleek-whats-included {
  text-align: center;
  padding: 60px 0;
  border-top: 1px solid var(--sleek-gray-200);
}

.sleek-included-title {
  font-size: 24px;
  font-weight: var(--font-weight-bold);
  margin: 0 0 40px;
}

.sleek-included-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  max-width: 800px;
  margin: 0 auto;
}

@media (min-width: 750px) {
  .sleek-included-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.sleek-included-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 20px;
  background: var(--glass-bg-light);
  backdrop-filter: var(--blur-light);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  transition: all var(--transition-base);
}

.sleek-included-item:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.sleek-included-item svg {
  color: var(--sleek-primary);
}

.sleek-included-item span {
  font-size: 14px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-gray-700);
}

.sleek-trust-section {
  text-align: center;
  padding-top: 60px;
  border-top: 1px solid var(--sleek-gray-200);
}

.sleek-trust-text {
  font-size: 14px;
  color: var(--sleek-gray-600);
  margin: 0 0 32px;
}

.sleek-trust-badges {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  max-width: 900px;
  margin: 0 auto;
}

@media (min-width: 750px) {
  .sleek-trust-badges {
    grid-template-columns: repeat(3, 1fr);
  }
}

.sleek-trust-badge {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px;
  background: var(--glass-bg-light);
  backdrop-filter: var(--blur-light);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  text-align: left;
}

.sleek-trust-badge svg {
  color: var(--sleek-success);
  flex-shrink: 0;
}

.sleek-trust-title {
  font-size: 16px;
  font-weight: var(--font-weight-semibold);
  color: var(--sleek-dark);
  margin-bottom: 4px;
}

.sleek-trust-subtitle {
  font-size: 13px;
  color: var(--sleek-gray-600);
}

.sleek-pricing-card {
  animation: fadeInUp 0.6s ease-out backwards;
}

.sleek-pricing-card:nth-child(1) { animation-delay: 0.1s; }
.sleek-pricing-card:nth-child(2) { animation-delay: 0.2s; }
.sleek-pricing-card:nth-child(3) { animation-delay: 0.3s; }
</style>

