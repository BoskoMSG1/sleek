{{ 'section-sleek-ai.css' | asset_url | stylesheet_tag }}

<div class="sleek-ai-section sleek-section">
  <div class="sleek-container-wide">
    
    <!-- Section Header -->
    <div class="sleek-ai-header">
      <div class="sleek-ai-badge">
        <span class="sleek-ai-badge-pulse"></span>
        <span>{{ section.settings.badge_text }}</span>
      </div>
      <h2 class="sleek-ai-title">{{ section.settings.title }}</h2>
      <p class="sleek-ai-description">{{ section.settings.description }}</p>
    </div>

    <!-- AI Demo Grid -->
    <div class="sleek-ai-grid">
      
      <!-- Left: AI Chat Interface -->
      <div class="sleek-ai-chat-wrapper">
        <div class="sleek-ai-chat sleek-glass-card">
          <div class="sleek-chat-header">
            <div class="sleek-chat-avatar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="sleek-chat-info">
              <h3 class="sleek-chat-name">AI Asistent</h3>
              <p class="sleek-chat-status">
                <span class="sleek-status-dot"></span>
                Online
              </p>
            </div>
          </div>

          <div class="sleek-chat-messages">
            <!-- User Message -->
            <div class="sleek-message sleek-message-user">
              <div class="sleek-message-content">
                <p>Kada je moj sledeći termin?</p>
                <span class="sleek-message-time">10:24</span>
              </div>
            </div>

            <!-- AI Response -->
            <div class="sleek-message sleek-message-ai">
              <div class="sleek-message-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="sleek-message-content">
                <p>Vaš sledeći termin je <strong>sutra u 14:00</strong> sa klijentom Marko Petrović. Želite li da dodate podsetnik?</p>
                <div class="sleek-message-actions">
                  <button class="sleek-message-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                      <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    Dodaj podsetnik
                  </button>
                  <button class="sleek-message-btn sleek-message-btn-outline">
                    Pogledaj detalje
                  </button>
                </div>
                <span class="sleek-message-time">10:24</span>
              </div>
            </div>

            <!-- User Message -->
            <div class="sleek-message sleek-message-user">
              <div class="sleek-message-content">
                <p>Da, hvala! I prikaži mi raspored za sutra.</p>
                <span class="sleek-message-time">10:25</span>
              </div>
            </div>

            <!-- AI Typing -->
            <div class="sleek-message sleek-message-ai">
              <div class="sleek-message-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="sleek-message-content">
                <div class="sleek-typing-indicator">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>
          </div>

          <div class="sleek-chat-input">
            <input type="text" placeholder="Pitajte AI asistenta..." readonly>
            <button class="sleek-chat-send">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Right: AI Features -->
      <div class="sleek-ai-features">
        {% for block in section.blocks %}
          <div class="sleek-ai-feature-card sleek-glass-card">
            <div class="sleek-ai-feature-icon" style="background: {{ block.settings.icon_color }};">
              {{ block.settings.icon_svg }}
            </div>
            <div class="sleek-ai-feature-content">
              <h3 class="sleek-ai-feature-title">{{ block.settings.title }}</h3>
              <p class="sleek-ai-feature-text">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endfor %}

        <!-- Integration Logos -->
        <div class="sleek-integrations">
          <p class="sleek-integrations-label">Integrisano sa:</p>
          <div class="sleek-integrations-grid">
            <div class="sleek-integration-logo sleek-glass">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/>
              </svg>
              <span>Apple Calendar</span>
            </div>
            <div class="sleek-integration-logo sleek-glass">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/>
                <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
              </svg>
              <span>Gmail</span>
            </div>
            <div class="sleek-integration-logo sleek-glass">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="M3 9h18M9 21V9" stroke="currentColor" stroke-width="2"/>
              </svg>
              <span>Outlook</span>
            </div>
            <div class="sleek-integration-logo sleek-glass">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>SMS</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
.sleek-ai-section {
  padding: 120px 0;
  position: relative;
  overflow: hidden;
}

/* Header */
.sleek-ai-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 80px;
}

.sleek-ai-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: linear-gradient(135deg, rgba(88, 86, 214, 0.1), rgba(0, 122, 255, 0.1));
  border: 1px solid rgba(88, 86, 214, 0.2);
  border-radius: var(--radius-full);
  font-size: 14px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-secondary);
  margin-bottom: 24px;
}

.sleek-ai-badge-pulse {
  width: 8px;
  height: 8px;
  background: var(--sleek-secondary);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

.sleek-ai-title {
  font-size: clamp(32px, 5vw, 56px);
  font-weight: var(--font-weight-heavy);
  line-height: 1.1;
  margin: 0 0 20px;
  letter-spacing: -0.02em;
}

.sleek-ai-description {
  font-size: 18px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  margin: 0;
}

/* Grid */
.sleek-ai-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  align-items: start;
}

@media (min-width: 990px) {
  .sleek-ai-grid {
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
}

/* Chat Interface */
.sleek-ai-chat-wrapper {
  position: sticky;
  top: 100px;
}

.sleek-ai-chat {
  padding: 0;
  overflow: hidden;
  max-width: 500px;
  margin: 0 auto;
}

.sleek-chat-header {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px;
  border-bottom: 1px solid var(--sleek-gray-200);
}

.sleek-chat-avatar {
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.sleek-chat-name {
  font-size: 16px;
  font-weight: var(--font-weight-semibold);
  margin: 0 0 4px;
}

.sleek-chat-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--sleek-gray-600);
  margin: 0;
}

.sleek-status-dot {
  width: 8px;
  height: 8px;
  background: var(--sleek-success);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

/* Messages */
.sleek-chat-messages {
  padding: 24px;
  max-height: 500px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.sleek-message {
  display: flex;
  gap: 12px;
  animation: fadeInUp 0.4s ease-out;
}

.sleek-message-user {
  flex-direction: row-reverse;
}

.sleek-message-avatar {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  flex-shrink: 0;
}

.sleek-message-content {
  max-width: 75%;
  background: var(--sleek-gray-100);
  padding: 12px 16px;
  border-radius: var(--radius-lg);
  position: relative;
}

.sleek-message-user .sleek-message-content {
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  color: white;
  border-radius: var(--radius-lg) var(--radius-lg) 4px var(--radius-lg);
}

.sleek-message-ai .sleek-message-content {
  border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 4px;
}

.sleek-message-content p {
  margin: 0 0 8px;
  font-size: 15px;
  line-height: 1.5;
}

.sleek-message-content p:last-child {
  margin-bottom: 0;
}

.sleek-message-time {
  font-size: 11px;
  color: var(--sleek-gray-500);
  display: block;
  text-align: right;
  margin-top: 4px;
}

.sleek-message-user .sleek-message-time {
  color: rgba(255, 255, 255, 0.7);
}

/* Message Actions */
.sleek-message-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--sleek-gray-200);
}

.sleek-message-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: white;
  border: 1px solid var(--sleek-gray-300);
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.sleek-message-btn:hover {
  background: var(--sleek-gray-50);
  border-color: var(--sleek-primary);
  color: var(--sleek-primary);
}

.sleek-message-btn-outline {
  background: transparent;
}

/* Typing Indicator */
.sleek-typing-indicator {
  display: flex;
  gap: 4px;
  padding: 8px 0;
}

.sleek-typing-indicator span {
  width: 8px;
  height: 8px;
  background: var(--sleek-gray-400);
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.sleek-typing-indicator span:nth-child(2) {
  animation-delay: 0.2s;
}

.sleek-typing-indicator span:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-10px);
  }
}

/* Chat Input */
.sleek-chat-input {
  display: flex;
  gap: 12px;
  padding: 20px 24px;
  border-top: 1px solid var(--sleek-gray-200);
}

.sleek-chat-input input {
  flex: 1;
  padding: 12px 16px;
  background: var(--sleek-gray-100);
  border: 1px solid var(--sleek-gray-200);
  border-radius: var(--radius-full);
  font-family: var(--font-ios);
  font-size: 14px;
  transition: all var(--transition-base);
}

.sleek-chat-input input:focus {
  outline: none;
  border-color: var(--sleek-primary);
  background: white;
}

.sleek-chat-send {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  cursor: pointer;
  transition: all var(--transition-base);
}

.sleek-chat-send:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 16px rgba(0, 122, 255, 0.3);
}

/* AI Features */
.sleek-ai-features {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.sleek-ai-feature-card {
  display: flex;
  gap: 20px;
  padding: 24px;
  transition: all var(--transition-base);
}

.sleek-ai-feature-card:hover {
  transform: translateX(4px);
}

.sleek-ai-feature-icon {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  flex-shrink: 0;
}

.sleek-ai-feature-title {
  font-size: 18px;
  font-weight: var(--font-weight-semibold);
  margin: 0 0 8px;
}

.sleek-ai-feature-text {
  font-size: 15px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  margin: 0;
}

/* Integrations */
.sleek-integrations {
  margin-top: 40px;
  padding: 32px;
  background: var(--glass-bg-light);
  backdrop-filter: var(--blur-light);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
}

.sleek-integrations-label {
  font-size: 14px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-gray-600);
  margin: 0 0 20px;
}

.sleek-integrations-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.sleek-integration-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 16px;
  border-radius: var(--radius-md);
  text-align: center;
  transition: all var(--transition-base);
}

.sleek-integration-logo:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.sleek-integration-logo svg {
  color: var(--sleek-primary);
}

.sleek-integration-logo span {
  font-size: 12px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-gray-700);
}
</style>

