{{ 'section-sleek-faq.css' | asset_url | stylesheet_tag }}

<div class="sleek-faq-section sleek-section">
  <div class="sleek-container">
    
    <!-- Section Header -->
    <div class="sleek-faq-header">
      <div class="sleek-faq-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>{{ section.settings.badge_text }}</span>
      </div>
      <h2 class="sleek-faq-title">{{ section.settings.title }}</h2>
      <p class="sleek-faq-description">{{ section.settings.description }}</p>
    </div>

    <div class="sleek-faq-layout">
      
      <!-- FAQ Accordion -->
      <div class="sleek-faq-accordion">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <div class="sleek-faq-item sleek-glass-card" {{ block.shopify_attributes }}>
              <button class="sleek-faq-question" onclick="toggleFAQ(this)">
                <span class="sleek-faq-question-text">{{ block.settings.question }}</span>
                <svg class="sleek-faq-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="sleek-faq-answer">
                <div class="sleek-faq-answer-content">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Contact Card -->
      {% if section.settings.show_contact_card %}
        <div class="sleek-faq-contact sleek-glass-card">
          <div class="sleek-contact-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="sleek-contact-title">{{ section.settings.contact_title }}</h3>
          <p class="sleek-contact-text">{{ section.settings.contact_text }}</p>
          
          <div class="sleek-contact-methods">
            {% if section.settings.show_email %}
              <a href="mailto:{{ section.settings.email_address }}" class="sleek-contact-method">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/>
                  <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
                </svg>
                <span>{{ section.settings.email_address }}</span>
              </a>
            {% endif %}
            
            {% if section.settings.show_phone %}
              <a href="tel:{{ section.settings.phone_number }}" class="sleek-contact-method">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2"/>
                </svg>
                <span>{{ section.settings.phone_number }}</span>
              </a>
            {% endif %}
            
            {% if section.settings.show_chat %}
              <a href="{{ section.settings.chat_link }}" class="sleek-contact-method">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2"/>
                </svg>
                <span>Live Chat</span>
              </a>
            {% endif %}
          </div>

          {% if section.settings.contact_button_text != blank %}
            <a href="{{ section.settings.contact_button_link }}" class="sleek-btn sleek-btn-primary" style="width: 100%; margin-top: 20px;">
              {{ section.settings.contact_button_text }}
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4.167 10h11.666M10 4.167L15.833 10 10 15.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}

    </div>

    <!-- Bottom CTA -->
    {% if section.settings.show_bottom_cta %}
      <div class="sleek-faq-bottom-cta sleek-glass-card">
        <div class="sleek-bottom-cta-content">
          <h3 class="sleek-bottom-cta-title">{{ section.settings.bottom_cta_title }}</h3>
          <p class="sleek-bottom-cta-text">{{ section.settings.bottom_cta_text }}</p>
        </div>
        <a href="{{ section.settings.bottom_cta_link }}" class="sleek-btn sleek-btn-primary">
          {{ section.settings.bottom_cta_button }}
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4.167 10h11.666M10 4.167L15.833 10 10 15.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {% endif %}

  </div>
</div>

<style>
.sleek-faq-section {
  padding: 100px 0;
  position: relative;
}

/* Header */
.sleek-faq-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 60px;
}

.sleek-faq-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: linear-gradient(135deg, rgba(88, 86, 214, 0.1), rgba(0, 122, 255, 0.1));
  border: 1px solid rgba(88, 86, 214, 0.2);
  border-radius: var(--radius-full);
  font-size: 14px;
  font-weight: var(--font-weight-medium);
  color: var(--sleek-secondary);
  margin-bottom: 24px;
}

.sleek-faq-badge svg {
  color: var(--sleek-secondary);
}

.sleek-faq-title {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: var(--font-weight-heavy);
  line-height: 1.2;
  margin: 0 0 20px;
  letter-spacing: -0.02em;
}

.sleek-faq-description {
  font-size: 18px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  margin: 0;
}

/* Layout */
.sleek-faq-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  align-items: start;
}

@media (min-width: 990px) {
  .sleek-faq-layout {
    grid-template-columns: 2fr 1fr;
  }
}

/* FAQ Accordion */
.sleek-faq-accordion {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.sleek-faq-item {
  padding: 0;
  overflow: hidden;
  transition: all var(--transition-base);
}

.sleek-faq-item:hover {
  box-shadow: var(--shadow-xl);
}

.sleek-faq-item.active {
  border-color: var(--sleek-primary);
}

/* Question Button */
.sleek-faq-question {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 24px 28px;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
  transition: all var(--transition-base);
}

.sleek-faq-question:hover {
  background: rgba(0, 122, 255, 0.03);
}

.sleek-faq-question-text {
  font-size: 18px;
  font-weight: var(--font-weight-semibold);
  color: var(--sleek-dark);
  line-height: 1.4;
}

.sleek-faq-icon {
  color: var(--sleek-primary);
  flex-shrink: 0;
  transition: transform var(--transition-base);
}

.sleek-faq-item.active .sleek-faq-icon {
  transform: rotate(180deg);
}

/* Answer */
.sleek-faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-slow);
}

.sleek-faq-item.active .sleek-faq-answer {
  max-height: 1000px;
}

.sleek-faq-answer-content {
  padding: 0 28px 28px;
  font-size: 16px;
  line-height: 1.7;
  color: var(--sleek-gray-700);
}

.sleek-faq-answer-content p {
  margin: 0 0 12px;
}

.sleek-faq-answer-content p:last-child {
  margin-bottom: 0;
}

.sleek-faq-answer-content ul {
  margin: 12px 0;
  padding-left: 24px;
}

.sleek-faq-answer-content li {
  margin-bottom: 8px;
}

/* Contact Card */
.sleek-faq-contact {
  padding: 32px;
  position: sticky;
  top: 100px;
  text-align: center;
}

.sleek-contact-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 20px;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.sleek-contact-title {
  font-size: 22px;
  font-weight: var(--font-weight-bold);
  margin: 0 0 12px;
}

.sleek-contact-text {
  font-size: 15px;
  color: var(--sleek-gray-600);
  margin: 0 0 24px;
  line-height: 1.6;
}

/* Contact Methods */
.sleek-contact-methods {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sleek-contact-method {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  background: var(--sleek-gray-50);
  border: 1px solid var(--sleek-gray-200);
  border-radius: var(--radius-md);
  text-decoration: none;
  color: var(--sleek-gray-700);
  transition: all var(--transition-base);
}

.sleek-contact-method:hover {
  background: white;
  border-color: var(--sleek-primary);
  color: var(--sleek-primary);
  transform: translateX(4px);
}

.sleek-contact-method svg {
  color: var(--sleek-primary);
  flex-shrink: 0;
}

/* Bottom CTA */
.sleek-faq-bottom-cta {
  margin-top: 60px;
  padding: 48px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
  text-align: center;
}

@media (min-width: 750px) {
  .sleek-faq-bottom-cta {
    flex-direction: row;
    text-align: left;
    justify-content: space-between;
  }
}

.sleek-bottom-cta-title {
  font-size: 24px;
  font-weight: var(--font-weight-bold);
  margin: 0 0 8px;
}

.sleek-bottom-cta-text {
  font-size: 16px;
  color: var(--sleek-gray-600);
  margin: 0;
}

/* Animations */
.sleek-faq-item {
  animation: fadeInUp 0.6s ease-out backwards;
}

.sleek-faq-item:nth-child(1) { animation-delay: 0.1s; }
.sleek-faq-item:nth-child(2) { animation-delay: 0.15s; }
.sleek-faq-item:nth-child(3) { animation-delay: 0.2s; }
.sleek-faq-item:nth-child(4) { animation-delay: 0.25s; }
.sleek-faq-item:nth-child(5) { animation-delay: 0.3s; }
.sleek-faq-item:nth-child(6) { animation-delay: 0.35s; }
</style>

<script>
function toggleFAQ(button) {
  const item = button.closest('.sleek-faq-item');
  const isActive = item.classList.contains('active');
  
  // Close all other items
  document.querySelectorAll('.sleek-faq-item').forEach(faqItem => {
    if (faqItem !== item) {
      faqItem.classList.remove('active');
    }
  });
  
  // Toggle current item
  item.classList.toggle('active', !isActive);
}

// Open first item by default
document.addEventListener('DOMContentLoaded', function() {
  const firstItem = document.querySelector('.sleek-faq-item');
  if (firstItem) {
    firstItem.classList.add('active');
  }
});
</script>

