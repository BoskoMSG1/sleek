{% comment %}
  HERO SECTION - iOS 26 Premium Style
  Dark theme with mesh gradients and glassmorphism
{% endcomment %}

<style>
/* ============================================
   iOS HERO SECTION - PREMIUM DARK STYLE
   ============================================ */

.ios-hero-wrapper {
  position: relative;
  min-height: 100vh;
  background: #0a0a0f;
  overflow: hidden;
}

/* Animated Mesh Gradient Background */
.ios-hero-wrapper::before {
  content: '';
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(circle at 15% 20%, rgba(102, 126, 234, 0.25) 0%, transparent 40%),
    radial-gradient(circle at 85% 80%, rgba(240, 147, 251, 0.2) 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, rgba(79, 172, 254, 0.15) 0%, transparent 50%);
  animation: refractLight 20s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

@keyframes refractLight {
  0%, 100% { 
    opacity: 1; 
    filter: blur(60px) hue-rotate(0deg); 
  }
  50% { 
    opacity: 0.85; 
    filter: blur(80px) hue-rotate(30deg); 
  }
}

/* Hero Container */
.ios-hero-section {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 180px 24px 80px;
}

.ios-hero-content {
  max-width: 900px;
  position: relative;
  z-index: 1;
  opacity: 0;
  animation: floatIn 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
}

@keyframes floatIn {
  from { 
    opacity: 0; 
    transform: translateY(60px) scale(0.95); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0) scale(1); 
  }
}

/* Hero Headline */
.ios-hero-headline {
  font-size: clamp(48px, 8vw, 92px);
  font-weight: 900;
  line-height: 1.05;
  margin-bottom: 28px;
  letter-spacing: -2px;
  color: white;
  filter: drop-shadow(0 0 40px rgba(102, 126, 234, 0.4));
}

/* Liquid Gradient Text */
.gradient-text {
  background: linear-gradient(
    135deg, 
    #667eea 0%, 
    #764ba2 25%, 
    #f093fb 50%, 
    #4facfe 75%, 
    #667eea 100%
  );
  background-size: 300% 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: liquidFlow 8s ease-in-out infinite;
  display: inline-block;
}

@keyframes liquidFlow {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* Hero Description */
.ios-hero-description {
  font-size: clamp(18px, 2.5vw, 24px);
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
  margin-bottom: 40px;
  font-weight: 400;
}

/* CTA Buttons */
.ios-hero-cta {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 40px;
}

.ios-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 36px;
  font-size: 17px;
  font-weight: 600;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  border: none;
  cursor: pointer;
  letter-spacing: -0.3px;
}

/* Primary Button - Gradient */
.ios-btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: 1.5px solid rgba(102, 126, 234, 0.4);
  box-shadow: 
    0 8px 24px rgba(102, 126, 234, 0.4),
    inset 0 1px 1px rgba(255, 255, 255, 0.2);
}

.ios-btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 
    0 12px 32px rgba(102, 126, 234, 0.5),
    inset 0 1px 1px rgba(255, 255, 255, 0.3);
  color: white;
}

/* Secondary Button - Glass */
.ios-btn-glass {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.9);
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.3),
    inset 0 1px 1px rgba(255, 255, 255, 0.15);
}

.ios-btn-glass:hover {
  transform: translateY(-3px);
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
  color: white;
  box-shadow: 
    0 12px 40px rgba(0, 0, 0, 0.4),
    inset 0 1px 1px rgba(255, 255, 255, 0.2);
}

/* Button Shine Effect */
.ios-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg, 
    transparent, 
    rgba(255, 255, 255, 0.2), 
    transparent
  );
  transition: left 0.5s ease;
}

.ios-btn:hover::before {
  left: 100%;
}

/* Arrow Icon Animation */
.btn-arrow {
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.ios-btn:hover .btn-arrow {
  transform: translateX(4px);
}

/* Feature Pills */
.ios-feature-pills {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 48px;
}

.feature-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.feature-pill:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
  transform: translateY(-2px);
}

.feature-pill svg {
  color: #30D158;
}

/* Scroll Indicator */
.ios-scroll-indicator {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: rgba(255, 255, 255, 0.5);
  font-size: 13px;
  font-weight: 500;
  z-index: 10;
  animation: scrollBounce 2s ease-in-out infinite;
}

.scroll-mouse {
  width: 24px;
  height: 40px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  position: relative;
}

.scroll-wheel {
  width: 4px;
  height: 8px;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 2px;
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  animation: scrollWheel 1.5s ease-in-out infinite;
}

@keyframes scrollBounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-10px); }
}

@keyframes scrollWheel {
  0% { opacity: 1; top: 8px; }
  100% { opacity: 0; top: 24px; }
}

/* Device Mockup (Optional) */
.ios-hero-device {
  position: relative;
  max-width: 800px;
  margin: 60px auto 0;
  perspective: 1500px;
  opacity: 0;
  animation: deviceReveal 1s ease-out 0.8s forwards;
}

@keyframes deviceReveal {
  from { 
    opacity: 0; 
    transform: translateY(40px) scale(0.9); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0) scale(1); 
  }
}

.device-screen {
  position: relative;
  width: 100%;
  aspect-ratio: 16/10;
  background: rgba(255, 255, 255, 0.03);
  border: 1.5px solid rgba(255, 255, 255, 0.1);
  border-radius: 32px;
  backdrop-filter: blur(20px);
  overflow: hidden;
  box-shadow: 
    0 40px 80px rgba(0, 0, 0, 0.5),
    inset 0 1px 1px rgba(255, 255, 255, 0.1);
  transition: transform 0.5s ease;
}

.device-screen:hover {
  transform: scale(1.02);
  box-shadow: 
    0 50px 100px rgba(0, 0, 0, 0.6),
    0 0 80px rgba(102, 126, 234, 0.3);
}

.device-screen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.9;
}

/* Responsive */
@media (max-width: 768px) {
  .ios-hero-section {
    padding: 140px 20px 60px;
  }

  .ios-hero-headline {
    font-size: clamp(36px, 10vw, 56px);
    margin-bottom: 20px;
  }

  .ios-hero-description {
    font-size: 16px;
    margin-bottom: 32px;
  }

  .ios-hero-cta {
    flex-direction: column;
    gap: 12px;
  }

  .ios-btn {
    width: 100%;
    justify-content: center;
  }

  .ios-feature-pills {
    margin-top: 32px;
  }

  .feature-pill {
    font-size: 13px;
    padding: 8px 14px;
  }
}
</style>

<div class="ios-hero-wrapper">
  <section class="ios-hero-section">
    
    <div class="ios-hero-content">
      
      <!-- Headline -->
      <h1 class="ios-hero-headline">
        {{ section.settings.headline_part1 }}
        <span class="gradient-text">{{ section.settings.headline_gradient }}</span>
        {{ section.settings.headline_part2 }}
      </h1>

      <!-- Description -->
      <p class="ios-hero-description">
        {{ section.settings.description }}
      </p>

      <!-- CTA Buttons -->
      <div class="ios-hero-cta">
        {% if section.settings.primary_button_text != blank %}
          <a href="{{ section.settings.primary_button_link }}" class="ios-btn ios-btn-primary">
            {{ section.settings.primary_button_text }}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="btn-arrow">
              <path d="M4.167 10h11.666M10 4.167L15.833 10 10 15.833" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.secondary_button_text != blank %}
          <a href="{{ section.settings.secondary_button_link }}" class="ios-btn ios-btn-glass">
            {{ section.settings.secondary_button_text }}
          </a>
        {% endif %}
      </div>

      <!-- Feature Pills -->
      {% if section.blocks.size > 0 %}
        <div class="ios-feature-pills">
          {% for block in section.blocks %}
            <div class="feature-pill" {{ block.shopify_attributes }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.15"/>
                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Optional Device Mockup -->
      {% if section.settings.show_device and section.settings.device_image %}
        <div class="ios-hero-device">
          <div class="device-screen">
            <img src="{{ section.settings.device_image | image_url: width: 1600 }}" 
                 alt="{{ section.settings.headline_part1 }}" 
                 loading="lazy">
          </div>
        </div>
      {% endif %}

    </div>

    <!-- Scroll Indicator -->
    {% if section.settings.show_scroll_indicator %}
      <div class="ios-scroll-indicator">
        <div class="scroll-mouse">
          <div class="scroll-wheel"></div>
        </div>
        <span>Scroll to explore</span>
      </div>
    {% endif %}

  </section>
</div>

{% schema %}
{
  "name": "iOS Hero Section",
  "settings": [
    {
      "type": "header",
      "content": "Headline Settings"
    },
    {
      "type": "text",
      "id": "headline_part1",
      "label": "Headline Part 1",
      "default": "Welcome to"
    },
    {
      "type": "text",
      "id": "headline_gradient",
      "label": "Headline Gradient Part",
      "default": "SLEEM",
      "info": "This part will have animated gradient"
    },
    {
      "type": "text",
      "id": "headline_part2",
      "label": "Headline Part 2",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium booking website solutions for modern businesses."
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Optional Device Mockup"
    },
    {
      "type": "checkbox",
      "id": "show_device",
      "label": "Show Device Mockup",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "device_image",
      "label": "Device Screen Image"
    },
    {
      "type": "header",
      "content": "Other Settings"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature_pill",
      "name": "Feature Pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "iOS Hero Section",
      "blocks": [
        {
          "type": "feature_pill",
          "settings": {
            "text": "5-star rated"
          }
        },
        {
          "type": "feature_pill",
          "settings": {
            "text": "Trusted by 10K+"
          }
        },
        {
          "type": "feature_pill",
          "settings": {
            "text": "99.9% uptime"
          }
        }
      ]
    }
  ]
}
{% endschema %}
