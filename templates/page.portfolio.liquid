{% comment %}
  PORTFOLIO PAGE TEMPLATE
  Usage: Create a page in Shopify Admin → Pages → Add page → Select template "portfolio"
{% endcomment %}

<style>
/* ============================================
   PORTFOLIO PAGE STYLES
   ============================================ */

.portfolio-hero {
  padding: 120px 0 60px;
  text-align: center;
  position: relative;
}

.portfolio-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  color: var(--sleek-primary);
  margin-bottom: 24px;
  animation: fadeInDown 0.6s ease-out;
}

.portfolio-badge svg {
  color: var(--sleek-primary);
}

.portfolio-hero h1 {
  font-size: clamp(48px, 6vw, 72px);
  font-weight: 700;
  margin-bottom: 20px;
  background: linear-gradient(135deg, var(--sleek-dark), var(--sleek-primary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: fadeInUp 0.6s ease-out 0.1s backwards;
}

.portfolio-hero-description {
  font-size: 20px;
  line-height: 1.6;
  color: var(--sleek-gray-600);
  max-width: 700px;
  margin: 0 auto 40px;
  animation: fadeInUp 0.6s ease-out 0.2s backwards;
}

/* Filter Buttons */
.portfolio-filters {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin: 60px 0 40px;
  animation: fadeInUp 0.6s ease-out 0.3s backwards;
}

.portfolio-filter-btn {
  padding: 12px 24px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  color: var(--sleek-dark);
  cursor: pointer;
  transition: all 0.3s ease;
}

.portfolio-filter-btn:hover,
.portfolio-filter-btn.active {
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  color: white;
  border-color: transparent;
  box-shadow: 0 4px 15px rgba(0, 122, 255, 0.3);
}

/* Portfolio Grid */
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 30px;
  margin: 60px auto;
  max-width: 1400px;
}

.portfolio-item {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  transition: all 0.4s ease;
  cursor: pointer;
  animation: fadeInUp 0.6s ease-out backwards;
}

.portfolio-item:nth-child(1) { animation-delay: 0.1s; }
.portfolio-item:nth-child(2) { animation-delay: 0.2s; }
.portfolio-item:nth-child(3) { animation-delay: 0.3s; }
.portfolio-item:nth-child(4) { animation-delay: 0.4s; }
.portfolio-item:nth-child(5) { animation-delay: 0.5s; }
.portfolio-item:nth-child(6) { animation-delay: 0.6s; }

.portfolio-item:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

.portfolio-item-image {
  width: 100%;
  height: 280px;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.portfolio-item:hover .portfolio-item-image {
  transform: scale(1.05);
}

.portfolio-item-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 30px;
}

.portfolio-item:hover .portfolio-item-overlay {
  opacity: 1;
}

.portfolio-item-category {
  display: inline-block;
  padding: 6px 14px;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  color: white;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
  width: fit-content;
}

.portfolio-item-content {
  padding: 24px;
}

.portfolio-item-title {
  font-size: 22px;
  font-weight: 600;
  color: var(--sleek-dark);
  margin-bottom: 8px;
  transition: color 0.3s ease;
}

.portfolio-item:hover .portfolio-item-title {
  color: var(--sleek-primary);
}

.portfolio-item-description {
  font-size: 15px;
  color: var(--sleek-gray-600);
  line-height: 1.5;
  margin-bottom: 16px;
}

.portfolio-item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.portfolio-tag {
  padding: 4px 12px;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 12px;
  font-size: 12px;
  color: var(--sleek-primary);
  font-weight: 500;
}

.portfolio-item-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  font-size: 14px;
  font-weight: 600;
  color: var(--sleek-primary);
  text-decoration: none;
  transition: gap 0.3s ease;
}

.portfolio-item-link:hover {
  gap: 10px;
}

/* Load More Button */
.portfolio-load-more {
  text-align: center;
  margin-top: 60px;
  animation: fadeInUp 0.6s ease-out 0.7s backwards;
}

.portfolio-load-more-btn {
  padding: 16px 40px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px;
  font-size: 16px;
  font-weight: 600;
  color: var(--sleek-dark);
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.portfolio-load-more-btn:hover {
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 122, 255, 0.3);
}

/* CTA Section */
.portfolio-cta {
  text-align: center;
  padding: 80px 30px;
  margin: 80px auto 0;
  max-width: 800px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 30px;
  animation: fadeInUp 0.6s ease-out 0.8s backwards;
}

.portfolio-cta h2 {
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 700;
  margin-bottom: 16px;
  background: linear-gradient(135deg, var(--sleek-dark), var(--sleek-primary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.portfolio-cta p {
  font-size: 18px;
  color: var(--sleek-gray-600);
  margin-bottom: 32px;
}

.portfolio-cta-btn {
  padding: 16px 40px;
  background: linear-gradient(135deg, var(--sleek-primary), var(--sleek-secondary));
  color: white;
  border: none;
  border-radius: 50px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(0, 122, 255, 0.3);
}

.portfolio-cta-btn:hover {
  box-shadow: 0 6px 25px rgba(0, 122, 255, 0.4);
  transform: translateY(-2px);
  color: white;
}

/* Responsive */
@media (max-width: 992px) {
  .portfolio-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .portfolio-hero {
    padding: 80px 0 40px;
  }

  .portfolio-grid {
    grid-template-columns: 1fr;
  }

  .portfolio-filters {
    margin: 40px 0 30px;
  }

  .portfolio-cta {
    padding: 60px 20px;
    margin-top: 60px;
  }
}

/* Animations */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>

